rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // โหมดผู้ใช้ทั่วไป (Guest): พื้นที่ข้อมูลแยกตามชื่อผู้ใช้
    // หมายเหตุ: ใครก็เข้าถึง guestId ที่รู้ได้ — เหมาะกับการใช้งานทั่วไป
    // ถ้าต้องการความปลอดภัยจริง ให้กลับมาใช้ระบบบัญชีจริงภายหลัง
    match /guests/{guestId}/{document=**} {
      allow read, write: if true;
    }

    match /meta/{docId} {
      allow read, write: if true;
    }

    // คอลเลกชันเดิม: อ่านได้ตอนย้ายข้อมูลครั้งเดียว ห้ามเขียนใหม่
    match /transactions/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
